{
  "uid": "myconfig-security-attacks",
  "title": "Attacks and reachability",
  "description": "Logged TCP SYN packets refused by the firewall and SSH authentication failures on hosts that opt into myconfig.networking.hardening. The firewall panels do not cover UDP or other dropped traffic.",
  "tags": ["myconfig", "security", "fail2ban", "firewall"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": {
          "query": "label_values(up, host)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Refused TCP connection attempts",
      "description": "Counts one kernel 'refused connection:' log line per logged TCP SYN, even if the source address or destination port cannot be parsed.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(loki:firewall_refused_connections_count{host=~\"$host\"}[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SSH auth failures",
      "description": "Failed password / publickey attempts across all selected hosts.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(loki:ssh_auth_failures_count{host=~\"$host\"}[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Banned IPs (now)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(fail2ban_jail_currently_banned{host=~\"$host\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bans handed out",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(fail2ban_jail_total_banned{host=~\"$host\"}[$__range]))",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Refused TCP connection attempts over time",
      "description": "Logged TCP SYN packets refused per second, by host.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (host) (loki:firewall_refused_connections_count{host=~\"$host\"}) / 60",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "SSH failures vs bans",
      "description": "auth failures observed (Loki) next to bans handed out (fail2ban counters). A gap means attempts are below the retry threshold.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (host) (loki:ssh_auth_failures_count{host=~\"$host\"})",
          "legendFormat": "{{host}} failures/min",
          "refId": "A"
        },
        {
          "expr": "sum by (host) (rate(fail2ban_jail_total_banned{host=~\"$host\"}[$__rate_interval])) * 60",
          "legendFormat": "{{host}} bans/min",
          "refId": "B"
        }
      ]
    },

    {
      "id": 20,
      "type": "bargauge",
      "title": "Top attacking source IPs",
      "description": "Top 10 source IPs by logged TCP refusals across the selected hosts and time range. Lines without a source address are excluded.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "src" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "topk(10, sum by (src) (count_over_time({job=\"systemd-journal\", log_stream=\"kernel\", host=~\"$host\"} |= \"refused connection:\" | regexp \" SRC=(?P<src>[^ ]+)\" | src!=\"\" [$__range])))",
          "legendFormat": "{{src}}",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 21,
      "type": "bargauge",
      "title": "Most probed TCP destination ports",
      "description": "Top 10 destination ports by logged TCP refusals across the selected hosts and time range. Lines without a numeric destination port are excluded.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "dpt" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "topk(10, sum by (dpt) (count_over_time({job=\"systemd-journal\", log_stream=\"kernel\", host=~\"$host\"} |= \"refused connection:\" | regexp \" DPT=(?P<dpt>[0-9]+)( |$)\" | dpt!=\"\" [$__range])))",
          "legendFormat": "port {{dpt}}",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Attack rate by host",
      "description": "Logged TCP refusals and SSH authentication failures per minute, by host.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "sum"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (host) (loki:firewall_refused_connections_count{host=~\"$host\"})",
          "legendFormat": "{{host}} refused",
          "refId": "A"
        },
        {
          "expr": "sum by (host) (loki:ssh_auth_failures_count{host=~\"$host\"})",
          "legendFormat": "{{host}} ssh failures",
          "refId": "B"
        }
      ]
    },

    {
      "id": 40,
      "type": "logs",
      "title": "Refused TCP connections (live tail)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 30 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{job=\"systemd-journal\", log_stream=\"kernel\", host=~\"$host\"} |= \"refused connection:\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 41,
      "type": "logs",
      "title": "SSH auth failures (live tail)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 30 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{job=\"systemd-journal\", log_stream=\"sshd\", host=~\"$host\"} |~ \"Failed (password|publickey)\"",
          "refId": "A"
        }
      ]
    }
  ]
}
