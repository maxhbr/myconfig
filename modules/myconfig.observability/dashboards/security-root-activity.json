{
  "uid": "myconfig-security-root-activity",
  "title": "Root activity",
  "description": "Privileged commands from the kernel audit log: every exec with euid 0, split into login-attributed (through sudo/su from a user session) and direct root logins. Fed by myconfig.security.audit.",
  "tags": [
    "myconfig",
    "security",
    "audit",
    "sudo"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up, host)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Root execs (login-attributed)",
      "description": "Execs with euid 0 reached from a user login session (auid>=1000), i.e. through sudo or su.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(loki:root_exec_count{host=~\"$host\"}[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Root logins (auid=0)",
      "description": "Execs with euid 0 and auid=0: a session that logged in as root directly, e.g. root@host over ssh. Expected during deploys, suspicious otherwise.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(loki:root_login_exec_count{host=~\"$host\"}[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "sudo invocations",
      "description": "Execs of the sudo binary itself, from any login session.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(loki:sudo_invocation_count{host=~\"$host\"}[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Distinct root commands",
      "description": "How many different programs ran as root. A sudden jump is the cheap signal that something unusual ran \u2014 compare against the top-commands panel.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(sum by (cmd) (count_over_time({job=\"systemd-journal\", log_stream=\"audit\", host=~\"$host\"} |~ `type=EXECVE` | regexp `a0=\"(?P<cmd>[^\"]+)\"` [$__range])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Root execs over time",
      "description": "Login-attributed root execs per minute, by host.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (host) (loki:root_exec_count{host=~\"$host\"})",
          "legendFormat": "{{host}} via sudo/su",
          "refId": "A"
        },
        {
          "expr": "sum by (host) (loki:root_login_exec_count{host=~\"$host\"})",
          "legendFormat": "{{host}} direct root login",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Root activity by login user",
      "description": "Which user session the privileged exec is attributable to (the audit auid, which survives sudo and su).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (user) (count_over_time({job=\"systemd-journal\", log_stream=\"audit\", host=~\"$host\"} |~ `type=SYSCALL.*key=\"root_exec\"` | regexp `auid=(?P<user>[0-9]+)` [5m]))",
          "legendFormat": "auid {{user}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "bargauge",
      "title": "Top commands run as root",
      "description": "Most frequent argv[0] of privileged execs in the selected range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(15, sum by (cmd) (count_over_time({job=\"systemd-journal\", log_stream=\"audit\", host=~\"$host\"} |~ `type=EXECVE` | regexp `a0=\"(?P<cmd>[^\"]+)\"` [$__range])))",
          "legendFormat": "{{cmd}}",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 21,
      "type": "table",
      "title": "Recent privileged execs",
      "description": "One row per exec: what ran, as which euid, attributed to which auid, plus the audit key that selected it.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "{job=\"systemd-journal\", log_stream=\"audit\", host=~\"$host\"} |~ `type=SYSCALL.*euid=0`",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "regexp",
            "regexp": "type=SYSCALL.*?auid=(?P<auid>[0-9]+).*?exe=\"(?P<exe>[^\"]+)\".*?key=\"(?P<key>[^\"]+)\"",
            "replace": false
          }
        }
      ]
    },
    {
      "id": 30,
      "type": "logs",
      "title": "Privileged execs with arguments (live tail)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{job=\"systemd-journal\", log_stream=\"audit\", host=~\"$host\"} |~ `type=(EXECVE|SYSCALL).*`",
          "refId": "A"
        }
      ]
    }
  ]
}
