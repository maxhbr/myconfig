#
# `mkShellConfig` — the sandbox-safe fish configuration of a mysbx
# sandbox whose interactive payload is the HOST's shell (`../default.nix`
# `shell.path`), instead of the bare `bash` of mysbx's own closure.
#
# Why a rendered tree instead of the host's `~/.config/fish`:
#
#   * The host's `config.fish` is generated by Home Manager and sources
#     `hm-session-vars.fish` — a file that carries HOST XDG paths and
#     model credentials. Mounting it hands both to the payload, the
#     opposite of what the sandbox's `--clearenv` is for.
#   * It also carries absolute HOST-home `source` lines (the handler
#     functions) that resolve nowhere below `/mysbx-home`.
#   * A directory mount of `~/.config/fish` is READ-ONLY, and fish must
#     write `fish_variables` in `$__fish_config_dir` (universal
#     variables, key bindings): the shell then prints
#     "Unable to create temporary file …/fish_variables: Read-only file
#     system" on every start.
#
# So this renders ONE self-contained tree of dereferenced REAL-FILE
# copies (`cp -RL`: home-manager deploys symlinks into its generation
# tree whose leaves point into the store), containing only:
#
#   * `config.fish` — the user's abbreviations, aliases and interactive
#                     init, WITHOUT the session-vars source;
#   * `conf.d/`     — the plugin/hydro startup files the host's fish
#                     loads (their store-path sources resolve inside the
#                     sandbox through the ro `/nix/store` bind);
#   * `functions/`  — the user's own fish functions.
#
# The caller mounts `subtrees` (`tree`-relative, `/mysbx-home`-relative)
# INDIVIDUALLY below the sandbox home, so fish's own state stays on the
# writable tmpfs home while the configuration is read-only.
#
# Returns `{ tree, subtrees, runtimePackages }` like
# `./sandbox-config.nix`'s `mkSandboxConfig`, and for the same reason: a
# plain function file, no NixOS option machinery.
#
# `runtimePackages` is the other half of the rendering: the tree carries
# the CONFIGURATION, and a fish reading it still needs the binaries that
# configuration names. Mounting a config without them is what made a
# sandbox session print "You need to install grc!" and lose its `eza`
# aliases — a rendered tree is only as useful as the `PATH` it is read
# under.
#
# `pkgs` is threaded in for those store paths (the caller's nixpkgs, the
# same revision the host's fish runs against); nothing else here needs it.
{
  lib,
  pkgs,
  runCommand,
}:
{
  # The home-manager `home.file` attrset of the user whose shell is
  # rendered — the single source of truth: a config change on the host
  # lands in the sandbox on the next build.
  homeFile,
  # The user's `home.homeDirectory`: home-manager keys `xdg.configFile`
  # entries under the ABSOLUTE `xdg.configHome`.
  homeDirectory,
  # The `programs.fish` option of that user. Its abbreviations, aliases
  # and `interactiveShellInit` are rendered into the tree's
  # `config.fish`; home-manager's own generated `config.fish` is
  # deliberately NOT mounted (see the header).
  fish,
  # Derivation name, e.g. "mysbx-shell-config".
  name ? "mysbx-shell-config",
}:
let
  configPrefix = ".config/fish";

  normalize =
    t: if lib.hasPrefix "${homeDirectory}/" t then lib.removePrefix "${homeDirectory}/" t else t;

  inSubtree = t: t == configPrefix || lib.hasPrefix "${configPrefix}/" t;

  entries = lib.mapAttrs' (target: v: lib.nameValuePair (normalize target) v) (
    lib.filterAttrs (target: _: inSubtree (normalize target)) homeFile
  );

  # Home-manager's own `sourceStorePath` trick (modules/files.nix): a
  # `source` that is a context-less store path — a flake source tree —
  # would not become a derivation input when stringified into the copy
  # script, and the build then fails with `cannot stat` on a builder
  # that lacks the path. Re-importing it via `builtins.path` adds the
  # context.
  sourceWithContext =
    source:
    let
      str = toString source;
    in
    if builtins.hasContext str then
      str
    else
      builtins.path {
        path = source;
        name = lib.strings.sanitizeDerivationName "${name}-source-${baseNameOf str}";
        recursive = lib.filesystem.pathIsDirectory source;
      };

  abbrs = lib.concatStrings (
    lib.mapAttrsToList (k: v: "abbr --add -- ${k} ${lib.escapeShellArg v}\n") fish.shellAbbrs
  );

  aliases = lib.concatStrings (
    lib.mapAttrsToList (k: v: "alias ${k} ${lib.escapeShellArg v}\n") fish.shellAliases
  );

  # The `interactiveShellInit` is host configuration source and may
  # legitimately name host paths (the generated-completions block does).
  # Any `source`/`.` line naming the home-manager session-vars package is
  # dropped: that file is what carries credentials and host XDG paths.
  stripSessionVars =
    text:
    lib.concatStringsSep "\n" (
      builtins.filter (line: !(lib.hasInfix "hm-session-vars" line && lib.hasInfix "source" line)) (
        lib.splitString "\n" text
      )
    );

  renderedConfig = lib.concatStrings [
    ''
      # Generated by myconfig for the mysbx sandbox — do not edit.
      #
      # The host's own ~/.config/fish/config.fish is NOT used here: its
      # session-variables include (host XDG paths + model credentials)
      # and its absolute host-home function loads do not belong in a
      # sandbox. This file carries the sandbox-relevant part of that
      # configuration — the user's abbreviations, aliases and
      # interactive init — so a sandbox session behaves like the host's
      # shell.
    ''
    "\n"
    "# Only execute this file once per shell.\n"
    "set -q __fish_mysbx_config_sourced; and exit\n"
    "set -g __fish_mysbx_config_sourced 1\n\n"
    "# Interactive shell initialisation\n"
    (stripSessionVars fish.interactiveShellInit)
    "\n\n# Abbreviations\n"
    abbrs
    "\n# Aliases\n"
    aliases
    (lib.optionalString (fish.shellInit != "") "\n# Shell init\n${stripSessionVars fish.shellInit}\n")
    (lib.optionalString (
      fish.loginShellInit != ""
    ) "\n# Login shell init\n${stripSessionVars fish.loginShellInit}\n")
  ];

  # BTree-style order (shortest target first, then lexicographic): a
  # `mkdir -p` of a later entry's parent must not collide with an earlier
  # copied FILE — the invariant home-manager's own files.nix sorts by.
  copied = lib.sortOn (e: [
    (builtins.stringLength e.target)
    e.target
  ]) (lib.attrValues (lib.filterAttrs (_: e: e.enable) entries));

  copyLine =
    e:
    let
      src = sourceWithContext e.source;
      # `.config/fish/functions/x.fish` → `functions/x.fish`
      rel = lib.removePrefix "${configPrefix}/" e.target;
    in
    ''
      mkdir -p "$out/${lib.dirOf rel}"
      # A source that does not resolve is skipped, not fatal: home-manager
      # deploys these entries as store symlinks, and an upstream plugin
      # that drops a file leaves a dangling link in the host's deployment
      # tree. The rest of the shell configuration must still be rendered
      # (observed: hydro no longer ships `fish_title.fish`).
      if [ -e ${lib.escapeShellArg (toString src)} ]; then
        cp -RL --no-preserve=mode -- ${lib.escapeShellArg (toString src)} "$out/${rel}"
      else
        echo "${name}: skipping dangling home.file source for ${e.target}" >&2
      fi
    '';

  tree = runCommand name { } (
    ''
      mkdir -p "$out"
    ''
    + lib.concatStrings (
      map copyLine (builtins.filter (e: e.target != "${configPrefix}/config.fish") copied)
    )
    + ''
      # Written LAST: a directory copy of `conf.d`/`functions` must not
      # have replaced or shadowed it. Emitted before the subtree check so
      # an empty host deployment still gets the file.
      printf '%s' ${lib.escapeShellArg renderedConfig} > "$out/config.fish"

      # A subtree with no host entry must still exist: the caller mounts
      # it, and a missing mount source is a hard error on every run.
      mkdir -p "$out/conf.d" "$out/functions"

      if [ -n "$(find "$out" -type l -print -quit)" ]; then
        echo "${name}: symlinks left in the output tree" >&2
        exit 1
      fi
      test -f "$out/config.fish"
    ''
  );

  subtrees = [
    "config.fish"
    "conf.d"
    "functions"
  ];

  # The store paths the rendered tree resolves at startup (see the
  # `pkgs` argument): the fish of the rendered configuration, the plugin
  # binaries its `conf.d` files probe for, and the tools its aliases
  # call. `fishBinary` is the exact package the host user runs, so the
  # re-exec in hydro's prompt hook finds the same shell.
  runtimePackages = [
    fish.package
    pkgs.grc
    pkgs.eza
    pkgs.bat
  ]
  # `any-nix-shell` is named by an ABSOLUTE store path in the rendered
  # `interactiveShellInit` (the host's config interpolates the
  # package), so it resolves through the `/nix/store` bind without
  # being on the PATH. Listed anyway when the host configured it: it
  # is part of what the rendered config executes.
  ++ lib.optionals (fish.interactiveShellInit != "") [ pkgs.any-nix-shell ];
in
{
  inherit tree subtrees runtimePackages;
}
