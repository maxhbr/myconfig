+use super::*;
+use crate::virtio::fs::filesystem::{Context, FileSystem, FsOptions};
+use std::path::PathBuf;
+
+pub(crate) struct Fixture {
+    pub fs: PassthroughFs,
+    pub handle: u64,
+    pub offset: u64,
+    root: PathBuf,
+    keys: Vec<InodeAltKey>,
+}
+
+pub(crate) fn ctx() -> Context {
+    Context {
+        uid: unsafe { libc::geteuid() },
+        gid: unsafe { libc::getegid() },
+        pid: unsafe { libc::getpid() },
+    }
+}
+
+impl Fixture {
+    pub fn new() -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let root = std::env::temp_dir().join(format!(
+            "krun-readdirplus-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        std::fs::create_dir(&root).unwrap();
+        for name in ["alpha", "bravo", "charlie", "delta"] {
+            std::fs::write(root.join(name), b"test").unwrap();
+        }
+        let mut paths = vec![root.clone(), root.parent().unwrap().to_path_buf()];
+        paths.extend(std::fs::read_dir(&root).unwrap().map(|p| p.unwrap().path()));
+        let keys = paths
+            .iter()
+            .map(|path| {
+                let (st, mnt_id) = statx(&File::open(path).unwrap()).unwrap();
+                InodeAltKey {
+                    ino: st.st_ino,
+                    dev: st.st_dev,
+                    mnt_id,
+                }
+            })
+            .collect();
+        let fs = PassthroughFs::new(
+            Config {
+                root_dir: root.to_str().unwrap().into(),
+                ..Default::default()
+            },
+            Arc::new(InodeAllocator::new()),
+        )
+        .unwrap();
+        fs.init(FsOptions::empty()).unwrap();
+        let handle = fs
+            .opendir(ctx(), fuse::ROOT_ID, libc::O_RDONLY as u32)
+            .unwrap()
+            .0
+            .unwrap();
+        // Start just before the first non-dot entry.
+        let mut offset = 0;
+        fs.readdir(ctx(), fuse::ROOT_ID, handle, 4096, 0, |d| {
+            if d.name == b"." || d.name == b".." {
+                offset = d.offset;
+                Ok(1)
+            } else {
+                Ok(0)
+            }
+        })
+        .unwrap();
+        Self {
+            fs,
+            handle,
+            offset,
+            root,
+            keys,
+        }
+    }
+
+    pub fn snapshot(&self) -> (BTreeMap<u64, u64>, usize) {
+        let refs = {
+            let inodes = self.fs.inodes.read().unwrap();
+            self.keys
+                .iter()
+                .filter_map(|key| {
+                    inodes
+                        .get_alt(key)
+                        .map(|d| (d.inode, d.refcount.load(Ordering::Relaxed)))
+                })
+                .collect()
+        };
+        let fds = std::fs::read_dir("/proc/self/fd")
+            .unwrap()
+            .filter_map(|p| std::fs::read_link(p.ok()?.path()).ok())
+            .filter(|p| p.starts_with(&self.root))
+            .count();
+        (refs, fds)
+    }
+}
+
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        self.fs
+            .releasedir(ctx(), fuse::ROOT_ID, 0, self.handle)
+            .unwrap();
+        self.fs.destroy();
+        std::fs::remove_dir_all(&self.root).unwrap();
+    }
+}
+
+#[test]
+fn readdirplus_rejected_first_entry() {
+    let f = Fixture::new();
+    let before = f.snapshot();
+    let mut calls = 0;
+    f.fs.readdirplus(ctx(), fuse::ROOT_ID, f.handle, 4096, f.offset, |_, _| {
+        calls += 1;
+        Ok(0)
+    })
+    .unwrap();
+    assert_eq!(calls, 1);
+    assert_eq!(f.snapshot(), before);
+}
+
+#[test]
+fn readdirplus_callback_error_releases_current_lookup() {
+    let f = Fixture::new();
+    let before = f.snapshot();
+    let err =
+        f.fs.readdirplus(ctx(), fuse::ROOT_ID, f.handle, 4096, f.offset, |_, _| {
+            Err(io::Error::from_raw_os_error(libc::EIO))
+        })
+        .unwrap_err();
+    assert_eq!(err.raw_os_error(), Some(libc::EIO));
+    assert_eq!(f.snapshot(), before);
+}
+
+#[test]
+fn readdirplus_accepted_then_full_preserves_live_references() {
+    let f = Fixture::new();
+    let before = f.snapshot();
+    let mut accepted = None;
+    let mut calls = 0;
+    f.fs.readdirplus(ctx(), fuse::ROOT_ID, f.handle, 4096, f.offset, |_, e| {
+        calls += 1;
+        if accepted.is_none() {
+            accepted = Some(e.inode);
+            Ok(160)
+        } else {
+            Ok(0)
+        }
+    })
+    .unwrap();
+    assert_eq!(calls, 2);
+    let inode = accepted.unwrap();
+    let old = before.0.get(&inode).copied().unwrap_or(0);
+    assert_eq!(f.snapshot().0[&inode], old + 1);
+    f.fs.forget(ctx(), inode, 1);
+    assert_eq!(f.snapshot(), before);
+}
