+use super::super::linux::passthrough::readdirplus_tests::{ctx, Fixture};
+use super::*;
+use crate::virtio::descriptor_utils::{create_descriptor_chain, DescriptorType};
+use vm_memory::{Bytes, GuestAddress, GuestMemoryMmap};
+
+#[derive(Clone, Copy)]
+enum Failure {
+    None,
+    Callback,
+    AfterEntries,
+}
+
+struct TestFs {
+    fixture: Fixture,
+    failure: Failure,
+}
+
+impl FileSystem for TestFs {
+    type Inode = u64;
+    type Handle = u64;
+
+    fn forget(&self, ctx: Context, inode: u64, count: u64) {
+        self.fixture.fs.forget(ctx, inode, count);
+    }
+
+    fn readdirplus<F>(
+        &self,
+        ctx: Context,
+        inode: u64,
+        handle: u64,
+        size: u32,
+        offset: u64,
+        mut add: F,
+    ) -> io::Result<()>
+    where
+        F: FnMut(DirEntry, Entry) -> io::Result<usize>,
+    {
+        let mut calls = 0;
+        self.fixture
+            .fs
+            .readdirplus(ctx, inode, handle, size, offset, |d, e| {
+                calls += 1;
+                if matches!(self.failure, Failure::Callback) && calls == 2 {
+                    Err(io::Error::from_raw_os_error(libc::EIO))
+                } else {
+                    add(d, e)
+                }
+            })?;
+        if matches!(self.failure, Failure::AfterEntries) {
+            Err(io::Error::from_raw_os_error(libc::EIO))
+        } else {
+            Ok(())
+        }
+    }
+}
+
+fn request(
+    server: &Server<TestFs>,
+    size: u32,
+    offset: u64,
+) -> (OutHeader, Vec<(u64, u64, Vec<u8>)>) {
+    let memory = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x10000)]).unwrap();
+    let input = ReadIn {
+        fh: server.fs.fixture.handle,
+        size,
+        offset,
+        ..Default::default()
+    };
+    let chain = create_descriptor_chain(
+        &memory,
+        GuestAddress(0),
+        GuestAddress(0x1000),
+        vec![(DescriptorType::Readable, size_of::<ReadIn>() as u32)],
+        0,
+    )
+    .unwrap();
+    memory.write_obj(input, GuestAddress(0x1000)).unwrap();
+    let reader = Reader::new(&memory, chain).unwrap();
+    let chain = create_descriptor_chain(
+        &memory,
+        GuestAddress(0x100),
+        GuestAddress(0x2000),
+        vec![
+            (DescriptorType::Writable, size_of::<OutHeader>() as u32),
+            (DescriptorType::Writable, size),
+        ],
+        0,
+    )
+    .unwrap();
+    let writer = Writer::new(&memory, chain).unwrap();
+    let header = InHeader {
+        nodeid: ROOT_ID,
+        unique: 42,
+        uid: ctx().uid,
+        gid: ctx().gid,
+        pid: ctx().pid as u32,
+        ..Default::default()
+    };
+    let len = server.do_readdir(header, reader, writer, true).unwrap();
+    let out: OutHeader = memory.read_obj(GuestAddress(0x2000)).unwrap();
+    assert_eq!(len, out.len as usize);
+    assert_eq!(out.unique, 42);
+    let mut pos = size_of::<OutHeader>();
+    let mut entries = Vec::new();
+    while pos < len {
+        let entry: EntryOut = memory.read_obj(GuestAddress(0x2000 + pos as u64)).unwrap();
+        pos += size_of::<EntryOut>();
+        let dirent: Dirent = memory.read_obj(GuestAddress(0x2000 + pos as u64)).unwrap();
+        let mut name = vec![0; dirent.namelen as usize];
+        memory
+            .read_slice(
+                &mut name,
+                GuestAddress(0x2000 + (pos + size_of::<Dirent>()) as u64),
+            )
+            .unwrap();
+        pos += (size_of::<Dirent>() + name.len() + 7) & !7;
+        entries.push((entry.nodeid, dirent.off, name));
+    }
+    assert_eq!(pos, len);
+    (out, entries)
+}
+
+fn server(failure: Failure) -> Server<TestFs> {
+    Server::new(TestFs {
+        fixture: Fixture::new(),
+        failure,
+    })
+}
+
+#[test]
+fn readdirplus_server_full_first_entry() {
+    let s = server(Failure::None);
+    let before = s.fs.fixture.snapshot();
+    let (out, entries) = request(&s, 128, s.fs.fixture.offset);
+    assert_eq!(out.error, 0);
+    assert!(entries.is_empty());
+    assert_eq!(s.fs.fixture.snapshot(), before);
+}
+
+#[test]
+fn readdirplus_server_accepted_then_callback_error() {
+    let s = server(Failure::Callback);
+    let before = s.fs.fixture.snapshot();
+    // Keep a pre-existing guest reference: double-FORGET must not consume it.
+    let name = CString::new("alpha").unwrap();
+    let entry = s.fs.fixture.fs.lookup(ctx(), ROOT_ID, &name).unwrap();
+    let live = s.fs.fixture.snapshot();
+    let (out, entries) = request(&s, 4096, s.fs.fixture.offset);
+    assert_eq!(out.error, -libc::EIO);
+    assert!(entries.is_empty());
+    assert_eq!(s.fs.fixture.snapshot(), live);
+    s.fs.fixture.fs.forget(ctx(), entry.inode, 1);
+    assert_eq!(s.fs.fixture.snapshot(), before);
+}
+
+#[test]
+fn readdirplus_server_whole_request_error_discards_entries() {
+    let s = server(Failure::AfterEntries);
+    let before = s.fs.fixture.snapshot();
+    let (out, entries) = request(&s, 4096, s.fs.fixture.offset);
+    assert_eq!(out.error, -libc::EIO);
+    assert!(entries.is_empty());
+    assert_eq!(s.fs.fixture.snapshot(), before);
+}
+
+#[test]
+fn readdirplus_server_pagination_and_guest_forget_balance() {
+    let s = server(Failure::None);
+    let before = s.fs.fixture.snapshot();
+    for _ in 0..20 {
+        let mut offset = s.fs.fixture.offset;
+        let mut returned = Vec::new();
+        let mut names = Vec::new();
+        for page in 0..10 {
+            // Exactly one entry fits: every non-final page rejects the next lookup.
+            let (out, entries) = request(&s, 160, offset);
+            assert_eq!(out.error, 0);
+            if entries.is_empty() {
+                break;
+            }
+            assert!(page < 9, "pagination did not terminate");
+            assert_eq!(entries.len(), 1);
+            for (inode, next, name) in entries {
+                offset = next;
+                returned.push(inode);
+                if name != b"." && name != b".." {
+                    names.push(name);
+                }
+            }
+        }
+        names.sort();
+        assert_eq!(
+            names,
+            vec![
+                b"alpha".to_vec(),
+                b"bravo".to_vec(),
+                b"charlie".to_vec(),
+                b"delta".to_vec()
+            ]
+        );
+        assert_eq!(
+            s.fs.fixture.snapshot().0.values().sum::<u64>(),
+            before.0.values().sum::<u64>() + returned.len() as u64
+        );
+        for inode in returned {
+            s.fs.fixture.fs.forget(ctx(), inode, 1);
+        }
+        assert_eq!(s.fs.fixture.snapshot(), before);
+    }
+}
