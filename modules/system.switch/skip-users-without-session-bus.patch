diff --git a/src/main.rs b/src/main.rs
--- a/src/main.rs
+++ b/src/main.rs
@@ -2413,6 +2413,29 @@
                     }
                 };
 
+                // The BindsTo= on user@.service keeps /run/user/<uid> and the
+                // user manager's lifetime in sync only while both units are
+                // loaded. For users whose manager was stopped (or never
+                // started) after their runtime directory was created — e.g.
+                // logind-managed greeter sessions or linger users whose
+                // user@<uid>.service is inactive — the directory can outlive
+                // the manager and the per-user session bus. Probe the socket
+                // before spawning: if it does not exist there is no user
+                // manager to reload units for, so skip the user instead of
+                // failing the whole switch.
+                let session_bus = runtime_path.join("bus");
+                if !nix::sys::stat::stat(&session_bus)
+                    .map(|st| st.st_mode & nix::libc::S_IFMT == nix::libc::S_IFSOCK)
+                    .unwrap_or(false)
+                {
+                    eprintln!(
+                        "skipping user {name}: {} is not a socket \
+                         (user manager not running)",
+                        session_bus.display()
+                    );
+                    continue;
+                }
+
                 eprintln!("reloading user units for {name}...");
                 let myself = Path::new("/proc/self/exe")
                     .canonicalize()
