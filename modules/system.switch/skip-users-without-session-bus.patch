diff --git a/src/main.rs b/src/main.rs
--- a/src/main.rs
+++ b/src/main.rs
@@ -2413,6 +2413,38 @@
                     }
                 };
 
+                // The BindsTo= on user@.service only stops the user manager
+                // when user-runtime-dir@.service goes away, not the other way
+                // round, so /run/user/<uid> (and a stale bus socket inside it)
+                // can outlive the manager: greeter sessions that ended, or
+                // linger users whose user@<uid>.service is inactive. Connect
+                // to the session bus the child would use; if nothing accepts,
+                // there are no user units to manage, so skip the user instead
+                // of failing the whole switch.
+                let session_bus = runtime_path.join("bus");
+                match std::os::unix::net::UnixStream::connect(&session_bus) {
+                    Ok(_) => {}
+                    Err(err)
+                        if matches!(
+                            err.kind(),
+                            std::io::ErrorKind::NotFound | std::io::ErrorKind::ConnectionRefused
+                        ) =>
+                    {
+                        eprintln!(
+                            "skipping user {name}: cannot connect to {} \
+                             ({err}; user manager not running)",
+                            session_bus.display()
+                        );
+                        continue;
+                    }
+                    Err(err) => {
+                        log::debug!(
+                            "probing {} for user {name} failed: {err}",
+                            session_bus.display()
+                        );
+                    }
+                }
+
                 eprintln!("reloading user units for {name}...");
                 let myself = Path::new("/proc/self/exe")
                     .canonicalize()
