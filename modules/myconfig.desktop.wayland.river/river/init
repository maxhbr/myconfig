#!/usr/bin/env bash
# river (river-classic, 0.3.x) init script.
#
# Documentation: riverctl(1), river(1), rivercarro(1)
#
# NOTE: river 0.4+ (nixpkgs `pkgs.river`) removed the built-in window
# management and with it this whole riverctl configuration interface.
# This module wraps `pkgs.river-classic`, the maintained 0.3 fork.

set -euo pipefail

logfile=/tmp/river.${XDG_VTNR}.${USER}.$(date +%F).log
exec &> >(tee -a "$logfile")
date
set -x

mod=Super
hypr=Super+Alt+Shift+Control

###############################################################################
# apps / session control
###############################################################################

riverctl map normal $mod Return spawn tfoot
riverctl map normal $mod+Shift Return spawn tfoot
riverctl map normal $mod+Control Return spawn foot
riverctl map normal $mod+Shift+Control Return spawn tfoot-reattach
riverctl map normal $mod P spawn my-wofi
riverctl map normal $mod+Shift P spawn "wofi --show run"
riverctl map normal None XF86Display spawn grim-region
riverctl map normal $mod W spawn grim-region

# close / exit
riverctl map normal $mod+Shift C close
riverctl map normal $mod+Shift+Control Q exit
riverctl map normal $mod+Shift Q spawn wlogout

# lock screen
riverctl map normal $mod+Shift Y spawn "swaylock -f -c 000000"
riverctl map normal $mod X spawn "swaylock -f -c 000000"
# Mod+Shift+X: power menu
riverctl map normal $mod+Shift X spawn wlogout
# power off all outputs (niri: Mod+Shift+Escape power-off-monitors)
riverctl map normal $mod+Shift Escape spawn "wlopm --off '*'"

###############################################################################
# focus / movement
###############################################################################

# $mod+J and $mod+K to focus the next/previous view in the layout stack
riverctl map normal $mod J focus-view next
riverctl map normal $mod Tab focus-view next
riverctl map normal $mod K focus-view previous

# swap the focused view with the next/previous view in the layout stack
riverctl map normal $mod+Shift J swap next
riverctl map normal $mod+Shift Tab swap next
riverctl map normal $mod+Shift K swap previous

# directional focus between views
riverctl map normal $mod Left focus-view left
riverctl map normal $mod Right focus-view right
riverctl map normal $mod Up focus-view up
riverctl map normal $mod Down focus-view down

# directional move of floating views
riverctl map normal $mod+Control Left move left 100
riverctl map normal $mod+Control Down move down 100
riverctl map normal $mod+Control Up move up 100
riverctl map normal $mod+Control Right move right 100

# $mod+Period and $mod+Comma to focus the next/previous output
riverctl map normal $mod Comma focus-output previous
riverctl map normal $mod Period focus-output next

# $mod+Shift+{Period,Comma} to send the focused view to the next/previous output
riverctl map normal $mod+Shift Comma send-to-output previous
riverctl map normal $mod+Shift Period send-to-output next

# move the focused view between the floating and the tiling layout
riverctl map normal $mod Space toggle-float

# bump the focused view to the top of the layout stack
riverctl map normal $mod Z zoom

# $mod + Left Mouse Button to move views
riverctl map-pointer normal $mod BTN_LEFT move-view

# $mod + Right Mouse Button to resize views
riverctl map-pointer normal $mod BTN_RIGHT resize-view

###############################################################################
# tags (= workspaces)
###############################################################################

homerow=("U" "I" "A" "E" "O" "S" "N" "R" "T")
for i in $(seq 1 9); do
    tags=$((1 << (i - 1)))

    riverctl map normal $mod "$i" set-focused-tags $tags
    riverctl map normal $mod+Shift "$i" set-view-tags $tags
    riverctl map normal $mod+Control "$i" toggle-focused-tags $tags
    riverctl map normal $mod+Shift+Control "$i" toggle-view-tags $tags
    riverctl map normal $mod "F${i}" toggle-view-tags $tags

    c="${homerow[$((i - 1))]}"
    riverctl map normal $mod "$c" set-focused-tags $tags
    riverctl map normal $mod+Shift "$c" set-view-tags $tags
    riverctl map normal $mod+Control "$c" toggle-focused-tags $tags
    riverctl map normal $mod+Shift+Control "$c" toggle-view-tags $tags
    riverctl map normal $hypr "$c" toggle-view-tags $tags
done

# focus all tags / tag focused view with all tags
all_tags=$(((1 << 32) - 1))
riverctl map normal $mod 0 set-focused-tags $all_tags
riverctl map normal $mod D set-focused-tags $all_tags
riverctl map normal $mod+Shift 0 set-view-tags $all_tags
riverctl map normal $mod+Shift D set-view-tags $all_tags

# jump back and forth between 2 tag setups (niri: Mod+Y focus-workspace-previous)
riverctl map normal $mod Y focus-previous-tags
riverctl map normal $mod+Shift Y send-to-previous-tags

# scratchpad: lives on an unused tag
scratch_tag=$((1 << 20))
riverctl map normal $mod Minus toggle-focused-tags ${scratch_tag}
riverctl map normal $mod+Shift Minus set-view-tags ${scratch_tag}

# ensure new windows don't get the scratchpad tag unless explicitly set
all_but_scratch_tag=$(((1 << 32) - 1 ^ scratch_tag))
riverctl spawn-tagmask ${all_but_scratch_tag}

###############################################################################
# modes
###############################################################################

# passthrough mode: only a single mapping to return to normal mode,
# useful for testing a nested wayland compositor
riverctl declare-mode passthrough
riverctl map normal $mod F11 enter-mode passthrough
riverctl map passthrough $mod F11 enter-mode normal

###############################################################################
# layout: rivercarro
###############################################################################

# rivercarro 0.6.x runtime commands, see rivercarro(1):
#   gaps/inner-gaps/outer-gaps, main-location, main-ratio, main-count,
#   width-ratio (+ -width-ratio-centered), per-tag

riverctl map normal $mod H send-layout-cmd rivercarro "main-ratio -0.05"
riverctl map normal $mod L send-layout-cmd rivercarro "main-ratio +0.05"

riverctl map normal $mod+Shift H send-layout-cmd rivercarro "main-count +1"
riverctl map normal $mod+Shift L send-layout-cmd rivercarro "main-count -1"

# Mod+F: monocle layout (single view fills the screen, others stacked behind)
riverctl map normal $mod F send-layout-cmd rivercarro "main-location monocle"

riverctl map normal $mod Left send-layout-cmd rivercarro "main-location left"
riverctl map normal $mod M send-layout-cmd rivercarro "main-location left"
riverctl map normal $mod G send-layout-cmd rivercarro "main-location left"

riverctl map normal $mod Up send-layout-cmd rivercarro "main-location top"
riverctl map normal $mod Right send-layout-cmd rivercarro "main-location right"
riverctl map normal $mod Down send-layout-cmd rivercarro "main-location bottom"

riverctl map normal $mod+Shift F toggle-fullscreen

# limit the width of the usable area of the screen
riverctl map normal $mod Page_Up send-layout-cmd rivercarro "width-ratio -0.1"
riverctl map normal $mod Page_Down send-layout-cmd rivercarro "width-ratio +0.1"

# gaps adjustments at runtime
riverctl map normal $mod+Shift Page_Up send-layout-cmd rivercarro "inner-gaps -2"
riverctl map normal $mod+Shift Page_Down send-layout-cmd rivercarro "inner-gaps +2"

riverctl default-layout rivercarro

###############################################################################
# window rules (rule-add, replaces float-filter-add / csd-filter-add)
###############################################################################

# headless hosts: the initial foot terminal hosts the main/host agent session
# (see myconfig.desktop.wayland.autostartCommands), open it fullscreen instead
# of tiling it (niri parity, see modules/myconfig.desktop.wayland.niri).
riverctl rule-add -app-id 'foot-host-tmux-session' fullscreen
riverctl rule-add -app-id 'host-tmux-session' fullscreen

# floating windows
riverctl rule-add -app-id float float
riverctl rule-add -app-id "popup" float
riverctl rule-add -title "(?:Open|Save) (?:File|Folder|As)" float
riverctl rule-add -title "Open Files" float
riverctl rule-add -app-id "pavucontrol" float
riverctl rule-add -app-id "wdisplays" float
riverctl rule-add -app-id "foot-bluetuith" float
riverctl rule-add -title "zoom" float # popups?
riverctl rule-add -title "Google Pay — Mozilla Firefox" float
# gimp:
riverctl rule-add -title "New Layer" float

# server-side decorations for everything that accepts them (niri: prefer-no-csd)
riverctl rule-add ssd
# …except for known-CSD offenders (replaces csd-filter-add)
riverctl rule-add -app-id "gedit" csd

###############################################################################
# appearance
###############################################################################

# background and border colors; urgent = attention requested by a view
# (e.g. activation on a non-visible tag)
riverctl background-color 0x002b36
riverctl border-color-focused 0xee9a00
riverctl border-color-unfocused 0xe0cbc7
riverctl border-color-urgent 0xf38ba8
riverctl border-width 4

###############################################################################
# input configuration (riverctl(1) INPUT CONFIGURATION)
###############################################################################

# keyboard: NEO layout via riverctl, so the compositor keymap matches the
# XKB_DEFAULT_* env vars even for nested/session restarts
if [ -n "${XKB_DEFAULT_LAYOUT:-}" ]; then
    kb_args=()
    [ -n "${XKB_DEFAULT_VARIANT:-}" ] && kb_args+=(-variant "${XKB_DEFAULT_VARIANT}")
    riverctl keyboard-layout "${kb_args[@]}" "${XKB_DEFAULT_LAYOUT}"
fi

# touchpad: tap-to-click, disable-while-typing, disable-while-trackpointing
# (niri parity)
riverctl input "type:touchpad" tap enabled
riverctl input "type:touchpad" disable-while-typing enabled
riverctl input "type:touchpad" disable-while-trackpointing enabled

# keyboard repeat rate
riverctl set-repeat 50 300

# cursor: hide while typing and after 5s of inactivity (niri parity).
# xcursor theme mirrors home.pointerCursor (myconfig.desktop.big-cursor.nix)
riverctl hide-cursor when-typing enabled
riverctl hide-cursor timeout 5000
if [ -n "${XCURSOR_THEME:-}" ]; then
    riverctl xcursor-theme "${XCURSOR_THEME}" "${XCURSOR_SIZE:-128}"
fi

riverctl focus-follows-cursor normal
riverctl set-cursor-warp on-focus-change

# allow tearing when a fullscreen view requests it
riverctl allow-tearing enabled

###############################################################################
# session behavior
###############################################################################

riverctl default-attach-mode bottom

riverctl spawn "$HOME/.config/river/autostart"

# lid switch: lock on close, wake outputs on open
riverctl map-switch normal lid close spawn "swaylock -f -c 000000"
riverctl map-switch normal lid open spawn "wlopm --on '*'"

###############################################################################
# media keys (work in normal and locked mode)
###############################################################################

for mode in normal locked; do
    # PipeWire volume keys
    riverctl map $mode None XF86AudioRaiseVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+'
    riverctl map $mode None XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-'
    riverctl map $mode None XF86AudioMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
    riverctl map $mode None XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'

    # MPRIS aware media players
    riverctl map $mode None XF86AudioMedia spawn 'playerctl play-pause'
    riverctl map $mode None XF86AudioPlay spawn 'playerctl play-pause'
    riverctl map $mode None XF86AudioPrev spawn 'playerctl previous'
    riverctl map $mode None XF86AudioNext spawn 'playerctl next'
    riverctl map $mode None XF86Go spawn 'playerctl play'
    riverctl map $mode None Cancel spawn 'playerctl pause'

    # disable airplane mode key (Fn+F10)
    riverctl map $mode None XF86WLAN spawn 'true'
    riverctl map $mode None XF86RFKill spawn 'true'
done

###############################################################################
# per-host additions, injected by modules/myconfig.desktop.wayland.river
###############################################################################

# @@river-extra-init@@

###############################################################################
# start the layout generator
#
# River will send the process group of the init executable SIGTERM on exit.
###############################################################################

pkill rivercarro 2>/dev/null || true
exec rivercarro -inner-gaps 6 -outer-gaps 6
