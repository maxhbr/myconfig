#!/usr/bin/env bash
set -Eeuo pipefail

STATE_ROOT="${AGENT_SANDBOX_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-sandbox}"
# AGENT_SANDBOX_DEFAULT_RUNTIME is baked in by the Nix package and is the
# absolute path of Nixpkgs' runsc, so gVisor works even when it is not
# registered as a named runtime in containers.conf. Set AGENT_PODMAN_RUNTIME to
# a name (for example "runsc") to use a runtime registered there instead.
PODMAN_RUNTIME="${AGENT_PODMAN_RUNTIME:-${AGENT_SANDBOX_DEFAULT_RUNTIME:-runsc}}"
# Rootless cgroup handling with runsc needs two adjustments, so both defaults
# depend on whether we are root:
#
#   - Podman's default systemd cgroup manager makes runsc ask the *system* bus
#     for a scope, which polkit denies for a normal user, so use cgroupfs.
#   - With cgroupfs, runsc still tries to configure the root cgroup
#     (/sys/fs/cgroup/cgroup.subtree_control), which a rootless user cannot
#     write, so tell it to ignore cgroups entirely.
#
# Consequence: rootless sandboxes are NOT resource limited. See limits_note().
# Both variables can be overridden, including to the empty string.
if (( EUID == 0 )); then
  CGROUP_MANAGER="${AGENT_PODMAN_CGROUP_MANAGER-}"
  read -r -a PODMAN_RUNTIME_FLAGS <<<"${AGENT_PODMAN_RUNTIME_FLAGS-}"
else
  CGROUP_MANAGER="${AGENT_PODMAN_CGROUP_MANAGER-cgroupfs}"
  read -r -a PODMAN_RUNTIME_FLAGS <<<"${AGENT_PODMAN_RUNTIME_FLAGS-ignore-cgroups}"
fi
# AGENT_SANDBOX_DEFAULT_IMAGE is baked in by the Nix package and points at the
# image built from this flake. AGENT_SANDBOX_IMAGE overrides it at runtime.
DEFAULT_IMAGE="${AGENT_SANDBOX_IMAGE:-${AGENT_SANDBOX_DEFAULT_IMAGE:-localhost/agent-dev:latest}}"

log() { printf 'agent-session: %s\n' "$*" >&2; }
die() { log "error: $*"; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing command: $1"; }

usage() {
  cat <<'USAGE'
Usage:
  agent-session start --name NAME --repo PATH [options] -- [COMMAND...]
  agent-session list
  agent-session status NAME
  agent-session run NAME [--detach] -- [COMMAND...]
  agent-session shell NAME [COMMAND...]
  agent-session logs NAME [PODMAN-LOGS-ARGS...]
  agent-session stop NAME
  agent-session destroy NAME [--force] [--delete-branch]
  agent-session doctor

start options:
  --base REF                  Base commit/ref in the host repository (default: HEAD)
  --branch BRANCH             Worktree branch (default: agent/NAME)
  --image IMAGE               Podman image (default: $AGENT_SANDBOX_DEFAULT_IMAGE)
  --config HOST:DEST[:ro|rw]  Mount an agent configuration path; repeatable
  --mount HOST:DEST[:ro|rw]   Add another bind mount; repeatable
  --env KEY=VALUE             Pass an environment variable; repeatable
  --env-file PATH             Pass a Podman environment file
  --network MODE              Podman network mode; omit to use the rootless default
  --detach                    Run detached rather than interactively
  --memory LIMIT              Memory limit (default: 8g)
  --cpus NUMBER               CPU limit (default: 4)
  --pids-limit NUMBER         Process limit (default: 2048)
  --seccomp-unconfined        Disable the inner OCI seccomp profile
  --force                     Destroy an existing session of the same name,
                              including its branch, instead of failing. Without
                              it an interactive terminal is asked to confirm,
                              and a non-interactive run fails.
  --home-seed PATH            Seed /home/agent from this directory instead of
                              the activated home-manager generation
  --no-home-seed              Start with an empty /home/agent

environment:
  AGENT_SANDBOX_IMAGE           Override the default image
  AGENT_PODMAN_RUNTIME          Runtime name or absolute path (default: runsc)
  AGENT_PODMAN_CGROUP_MANAGER   Podman cgroup manager (default: cgroupfs)
  AGENT_PODMAN_RUNTIME_FLAGS    Extra runsc flags, e.g. "ignore-cgroups"
  AGENT_SANDBOX_STATE           State directory
  AGENT_SANDBOX_HOME_SEED       Directory to seed /home/agent from (default:
                                the activated home-manager generation's
                                home-files)
  AGENT_SANDBOX_HOME_SEED_PATHS Space-separated relative paths copied from that
                                directory; empty disables seeding
  AGENT_SANDBOX_HOME_SEED_REWRITE
                                Space-separated OLD=NEW rules applied literally
                                to the seeded files, to point host-only
                                endpoints at sandbox-reachable ones
  AGENT_SANDBOX_MODEL_ENDPOINT  Model API base URL as seen from a sandbox;
                                `doctor` probes it from inside one

Run `agent-session doctor` to verify runtime, image and sandbox startup.

The host checkout is never bind-mounted. It seeds a disposable bare Git pool.
The worktree and its Git pool are mounted at identical absolute paths because
Git worktree administrative files contain absolute paths.
USAGE
}

sanitize_container_name() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_.-]+/-/g; s/^-+//; s/-+$//'
}

validate_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] ||
    die "invalid session name '$1' (allowed: letters, digits, dot, underscore, hyphen)"
}

# Global Podman flags. They must be repeated for every command that touches a
# container, because the runtime is not registered in containers.conf when it is
# given as an absolute path.
podman_global_args() {
  local -a args=("--runtime=$PODMAN_RUNTIME")
  [[ -z "$CGROUP_MANAGER" ]] || args+=("--cgroup-manager=$CGROUP_MANAGER")
  local flag
  for flag in ${PODMAN_RUNTIME_FLAGS[@]+"${PODMAN_RUNTIME_FLAGS[@]}"}; do
    [[ -n "$flag" ]] || continue
    args+=("--runtime-flag=$flag")
  done
  printf '%s\n' "${args[@]}"
}

# True when the runtime was told to ignore cgroups, in which case Podman's
# resource limits cannot be enforced.
cgroups_ignored() {
  local flag
  for flag in ${PODMAN_RUNTIME_FLAGS[@]+"${PODMAN_RUNTIME_FLAGS[@]}"}; do
    [[ "$flag" != ignore-cgroups ]] || return 0
  done
  return 1
}

limits_note() {
  printf '%s' 'not enforced, the runtime ignores cgroups'
}

podman_c() {
  local -a global=()
  mapfile -t global < <(podman_global_args)
  podman "${global[@]}" "$@"
}

# `exec` cannot run a shell function, so replace the shell explicitly here.
podman_exec_c() {
  local -a global=()
  mapfile -t global < <(podman_global_args)
  exec podman "${global[@]}" "$@"
}

check_runtime() {
  if [[ "$PODMAN_RUNTIME" = /* ]]; then
    [[ -x "$PODMAN_RUNTIME" ]] ||
      die "OCI runtime is not executable: $PODMAN_RUNTIME"
    return
  fi
  # Named runtimes must be registered in containers.conf; Podman only reports
  # its default one, so probe the requested name instead of parsing config.
  podman_c info >/dev/null 2>&1 || die "$(
    printf 'Podman OCI runtime %q is not registered.\n' "$PODMAN_RUNTIME"
    printf 'Register it in containers.conf (see nixos/agent-sandboxes.nix), or\n'
    printf 'set AGENT_PODMAN_RUNTIME to the absolute path of a runsc binary.'
  )"
}

check_image() {
  local image=$1
  podman image exists "$image" && return
  die "$(
    printf 'container image %q is not in the local Podman store.\n' "$image"
    printf 'Build and load it with: agent-sandbox-load-image\n'
    printf '(or: nix run .#load-image), or pass --image with another reference.'
  )"
}

parse_mount() {
  local spec=$1 default_mode=$2
  local host dest mode extra
  IFS=: read -r host dest mode extra <<<"$spec"
  [[ -n "$host" && -n "$dest" && -z "${extra:-}" ]] ||
    die "invalid mount '$spec'; expected HOST:DEST[:ro|rw]"
  [[ "$dest" = /* ]] || die "container mount destination must be absolute: $dest"
  mode=${mode:-$default_mode}
  [[ "$mode" = ro || "$mode" = rw ]] || die "mount mode must be ro or rw: $spec"
  host=$(realpath -e -- "$host") || die "mount source does not exist: $host"
  printf '%s\t%s\t%s\n' "$host" "$dest" "$mode"
}

load_meta() {
  local name=$1
  META_DIR="$STATE_ROOT/sessions/$name"
  [[ -f "$META_DIR/meta" ]] || die "unknown session: $name"
  # The file is generated by this script with shell-escaped values.
  # shellcheck disable=SC1090,SC1091
  source "$META_DIR/meta"
}

run_container() {
  local name=$1 detach=$2
  shift 2
  load_meta "$name"
  check_runtime
  check_image "$image"

  local -a global=()
  mapfile -t global < <(podman_global_args)
  local -a cmd=(podman "${global[@]}" run --replace)
  if [[ "$detach" = true ]]; then
    cmd+=(--detach)
  else
    cmd+=(--interactive --tty)
  fi

  cmd+=(
    --name "$container"
    --hostname "$name"
    --userns=keep-id
    --read-only
    --read-only-tmpfs=true
    --cap-drop=ALL
    --security-opt=no-new-privileges
    --workdir "$worktree"
    --mount "type=bind,src=$worktree,dst=$worktree,rw"
    --mount "type=bind,src=$pool,dst=$pool,rw"
    --mount "type=bind,src=$home,dst=/home/agent,rw"
    --env HOME=/home/agent
    --env XDG_CONFIG_HOME=/home/agent/.config
    --env XDG_CACHE_HOME=/home/agent/.cache
    --env XDG_STATE_HOME=/home/agent/.local/state
    --env AGENT_SESSION="$name"
    --env AGENT_WORKTREE="$worktree"
  )

  if cgroups_ignored; then
    log "warning: memory/cpu/pids limits $(limits_note)"
  else
    cmd+=(--pids-limit "$pids_limit" --memory "$memory" --cpus "$cpus")
  fi

  [[ -z "$network" ]] || cmd+=(--network "$network")
  [[ "$seccomp_unconfined" = false ]] || cmd+=(--security-opt=seccomp=unconfined)
  [[ -z "$env_file" ]] || cmd+=(--env-file "$env_file")

  if [[ -f "$META_DIR/mounts.tsv" ]]; then
    while IFS=$'\t' read -r host dest mode; do
      [[ -n "$host" ]] || continue
      cmd+=(--mount "type=bind,src=$host,dst=$dest,$mode")
    done < "$META_DIR/mounts.tsv"
  fi

  if [[ -f "$META_DIR/env.list" ]]; then
    while IFS= read -r item; do
      [[ -n "$item" ]] || continue
      cmd+=(--env "$item")
    done < "$META_DIR/env.list"
  fi

  cmd+=("$image")
  if (( $# == 0 )); then
    cmd+=(/bin/bash)
  else
    cmd+=("$@")
  fi

  printf '%q ' "${cmd[@]}" > "$META_DIR/last-command"
  printf '\n' >> "$META_DIR/last-command"
  exec "${cmd[@]}"
}

# --- home seeding ------------------------------------------------------
# Seed a fresh session home from the CURRENTLY ACTIVATED home-manager
# generation of the calling user, so an agent finds its own configuration
# (skills, prompts, agent settings) inside the sandbox. The generation is
# resolved at runtime, so it always matches what is actually activated, and
# the image never has to be rebuilt for a dotfile change.
#
# NOTE: `home-files` is a forest of symlinks INTO /nix/store and the sandbox
# deliberately has no /nix, so files are copied DEREFERENCED. Configuration
# whose *content* points at /nix/store paths therefore still dangles inside
# the sandbox; that is a property of the isolation boundary, not something
# seeding can fix.
resolve_home_files() {
  local user base
  user=${USER:-$(id -un)}
  for base in \
    "${XDG_STATE_HOME:-$HOME/.local/state}/home-manager/gcroots/current-home" \
    "/nix/var/nix/gcroots/per-user/$user/current-home" \
    "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/home-manager" \
    "/nix/var/nix/profiles/per-user/$user/home-manager"; do
    [[ -e "$base/home-files" ]] || continue
    readlink -f "$base/home-files"
    return 0
  done
  return 1
}

seed_home() {
  local home=$1 seed=$2
  local -a paths=()
  read -r -a paths <<<"${AGENT_SANDBOX_HOME_SEED_PATHS-}"
  (( ${#paths[@]} )) || return 0
  local rel copied=0
  for rel in "${paths[@]}"; do
    [[ -n "$rel" && -e "$seed/$rel" ]] || continue
    mkdir -p "$home/$(dirname "$rel")"
    cp -RL --no-preserve=mode -- "$seed/$rel" "$home/$rel"
    copied=$((copied + 1))
  done
  # Store files are read-only; the agent must be able to rewrite its config.
  chmod -R u+rwX "$home"
  log "seeded /home/agent with $copied path(s) from $seed"
  rewrite_seeded_home "$home"
}

# Host-side endpoints baked into the copied configuration do not exist inside
# the sandbox: the host LiteLLM proxy is loopback-only, and the sandbox's own
# 127.0.0.1 is the container's loopback. Rewrite such references to the
# addresses that ARE reachable from a sandbox.
#
# AGENT_SANDBOX_HOME_SEED_REWRITE is a space-separated list of OLD=NEW rules;
# replacement is literal (no regex), and binary files are skipped.
rewrite_seeded_home() {
  local home=$1
  local -a rules=()
  read -r -a rules <<<"${AGENT_SANDBOX_HOME_SEED_REWRITE-}"
  (( ${#rules[@]} )) || return 0
  local rule from to file content changed=0
  for rule in "${rules[@]}"; do
    [[ -n "$rule" ]] || continue
    from=${rule%%=*}
    to=${rule#*=}
    [[ -n "$from" && "$from" != "$rule" ]] ||
      die "invalid home-seed rewrite rule (expected OLD=NEW): $rule"
    while IFS= read -r -d '' file; do
      content=$(<"$file")
      printf '%s\n' "${content//"$from"/"$to"}" > "$file"
      changed=$((changed + 1))
    done < <(grep -rIlZF -- "$from" "$home" 2>/dev/null || true)
  done
  (( changed == 0 )) || log "applied $changed host-endpoint rewrite(s) to the seeded configuration"
}

# Interactive recovery from a leftover session of the same name: ask whether
# to destroy it (worktree AND branch) instead of just erroring out. Returns
# non-zero when there is no terminal to ask on, so non-interactive callers
# keep the previous fail-fast behaviour.
confirm_destroy_existing() {
  local session=$1 old_branch=$2 reply
  [[ -t 0 && -t 2 ]] || return 1
  printf 'agent-session: session %s already exists; destroy it and delete branch %s? [y/N] ' \
    "$session" "$old_branch" >&2
  read -r reply || return 1
  [[ "$reply" == [Yy] || "$reply" == [Yy][Ee][Ss] ]]
}

cmd_start() {
  local name='' repo='' base=HEAD branch='' image=$DEFAULT_IMAGE
  local detach=false memory=8g cpus=4 pids_limit=2048 network=''
  local seccomp_unconfined=false env_file='' force=false
  local home_seed='' seed_home_enabled=true
  local -a mount_specs=() env_specs=()

  while (( $# )); do
    case "$1" in
      --name) name=${2:?}; shift 2 ;;
      --repo) repo=${2:?}; shift 2 ;;
      --base) base=${2:?}; shift 2 ;;
      --branch) branch=${2:?}; shift 2 ;;
      --image) image=${2:?}; shift 2 ;;
      --config) mount_specs+=("$(parse_mount "${2:?}" ro)"); shift 2 ;;
      --mount) mount_specs+=("$(parse_mount "${2:?}" rw)"); shift 2 ;;
      --env) env_specs+=("${2:?}"); shift 2 ;;
      --env-file) env_file=$(realpath -e -- "${2:?}"); shift 2 ;;
      --network) network=${2:?}; shift 2 ;;
      --detach) detach=true; shift ;;
      --memory) memory=${2:?}; shift 2 ;;
      --cpus) cpus=${2:?}; shift 2 ;;
      --pids-limit) pids_limit=${2:?}; shift 2 ;;
      --seccomp-unconfined) seccomp_unconfined=true; shift ;;
      --force) force=true; shift ;;
      --home-seed) home_seed=$(realpath -e -- "${2:?}"); shift 2 ;;
      --no-home-seed) seed_home_enabled=false; shift ;;
      --) shift; break ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown start option: $1" ;;
    esac
  done

  [[ -n "$name" ]] || die "--name is required"
  [[ -n "$repo" ]] || die "--repo is required"
  validate_name "$name"
  need git; need podman; need flock; need sha256sum; need realpath

  # Fail before any worktree or session state is created.
  check_runtime
  check_image "$image"

  repo=$(realpath -e -- "$repo")
  git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a Git working tree: $repo"
  local base_commit
  base_commit=$(git -C "$repo" rev-parse --verify "$base^{commit}") || die "cannot resolve base ref: $base"
  branch=${branch:-agent/$name}

  mkdir -p "$STATE_ROOT" "$STATE_ROOT/pools" "$STATE_ROOT/worktrees" "$STATE_ROOT/sessions"
  local repo_id pool worktree meta_dir home container lockfile
  repo_id=$(printf '%s' "$repo" | sha256sum | cut -c1-16)
  pool="$STATE_ROOT/pools/$repo_id.git"
  worktree="$STATE_ROOT/worktrees/$repo_id/$name"
  meta_dir="$STATE_ROOT/sessions/$name"
  home="$meta_dir/home"
  container=$(sanitize_container_name "agent-$repo_id-$name")
  lockfile="$STATE_ROOT/pools/$repo_id.lock"

  if [[ -e "$meta_dir" ]]; then
    local old_branch
    # Both calls run in a subshell: load_meta sources the OLD session's meta
    # file, and cmd_destroy calls it, so without the subshell bash's dynamic
    # scoping would overwrite the locals computed just above (pool, worktree,
    # container, home, branch, image, ...) with the old session's values.
    old_branch=$( (load_meta "$name" >/dev/null 2>&1 && printf '%s' "$branch") || printf '%s' "$branch")
    if [[ "$force" = true ]]; then
      log "--force: destroying existing session $name and deleting branch $old_branch"
    else
      confirm_destroy_existing "$name" "$old_branch" \
        || die "session already exists: $name (pass --force, or remove it with 'agent-session destroy $name --force --delete-branch')"
    fi
    (cmd_destroy "$name" --force --delete-branch) \
      || die "could not destroy the existing session: $name"
  fi
  mkdir -p "$(dirname "$worktree")" "$meta_dir" "$home"
  # The session home is bind-mounted over /home/agent, which masks the XDG
  # directories created in the image, so create them on the host side.
  mkdir -p "$home/.cache" "$home/.config" "$home/.local/state"
  chmod 700 "$meta_dir" "$home"

  if [[ "$seed_home_enabled" = true ]]; then
    local seed=${home_seed:-${AGENT_SANDBOX_HOME_SEED-}}
    [[ -n "$seed" ]] || seed=$(resolve_home_files || true)
    if [[ -n "$seed" ]]; then
      [[ -d "$seed" ]] || die "home seed is not a directory: $seed"
      seed_home "$home" "$seed"
    fi
  fi

  exec 9>"$lockfile"
  flock 9

  if [[ ! -d "$pool" ]]; then
    git init --bare "$pool" >/dev/null
    git --git-dir="$pool" remote add host "$repo"
  else
    git --git-dir="$pool" remote set-url host "$repo"
  fi

  git --git-dir="$pool" fetch --prune --no-recurse-submodules host \
    '+refs/heads/*:refs/remotes/host/*' \
    '+refs/tags/*:refs/tags/*'
  if ! git --git-dir="$pool" cat-file -e "$base_commit^{commit}" 2>/dev/null; then
    git --git-dir="$pool" fetch --no-tags host "$base_commit"
  fi

  [[ ! -e "$worktree" ]] || die "worktree path already exists: $worktree"
  if git --git-dir="$pool" show-ref --verify --quiet "refs/heads/$branch"; then
    git --git-dir="$pool" worktree add "$worktree" "$branch"
  else
    git --git-dir="$pool" worktree add -b "$branch" "$worktree" "$base_commit"
  fi

  {
    printf 'name=%q\n' "$name"
    printf 'repo=%q\n' "$repo"
    printf 'repo_id=%q\n' "$repo_id"
    printf 'pool=%q\n' "$pool"
    printf 'worktree=%q\n' "$worktree"
    printf 'home=%q\n' "$home"
    printf 'container=%q\n' "$container"
    printf 'branch=%q\n' "$branch"
    printf 'image=%q\n' "$image"
    printf 'memory=%q\n' "$memory"
    printf 'cpus=%q\n' "$cpus"
    printf 'pids_limit=%q\n' "$pids_limit"
    printf 'network=%q\n' "$network"
    printf 'seccomp_unconfined=%q\n' "$seccomp_unconfined"
    printf 'env_file=%q\n' "$env_file"
  } > "$meta_dir/meta"
  printf '%s\n' "${mount_specs[@]}" > "$meta_dir/mounts.tsv"
  printf '%s\n' "${env_specs[@]}" > "$meta_dir/env.list"

  flock -u 9
  log "created worktree $worktree on branch $branch"
  log "if the container fails to start the session is kept; retry with" \
      "'agent-session run $name', diagnose with 'agent-session doctor', or" \
      "clean up with 'agent-session destroy $name --force'"
  run_container "$name" "$detach" "$@"
}

cmd_list() {
  mkdir -p "$STATE_ROOT/sessions"
  printf '%-24s %-12s %-28s %s\n' SESSION STATUS BRANCH WORKTREE
  local dir name status='stopped'
  shopt -s nullglob
  for dir in "$STATE_ROOT"/sessions/*; do
    name=${dir##*/}
    # shellcheck disable=SC1090,SC1091
    source "$dir/meta"
    if podman_c container exists "$container" 2>/dev/null; then
      status=$(podman_c inspect --format '{{.State.Status}}' "$container" 2>/dev/null || printf unknown)
    else
      status=stopped
    fi
    printf '%-24s %-12s %-28s %s\n' "$name" "$status" "$branch" "$worktree"
  done
}

cmd_status() {
  load_meta "${1:?session name required}"
  printf 'session:   %s\nrepo:      %s\nbranch:    %s\nworktree:  %s\npool:      %s\ncontainer: %s\nimage:     %s\n' \
    "$name" "$repo" "$branch" "$worktree" "$pool" "$container" "$image"
  if podman_c container exists "$container" 2>/dev/null; then
    podman_c inspect --format 'status:    {{.State.Status}}\npid:       {{.State.Pid}}\nstarted:   {{.State.StartedAt}}' "$container"
  else
    printf 'status:    stopped/absent\n'
  fi
  git -C "$worktree" status --short --branch
}

cmd_run() {
  local session=${1:?session name required}; shift
  local detach=false
  while (( $# )); do
    case "$1" in
      --detach) detach=true; shift ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  load_meta "$session"
  if podman_c container exists "$container" 2>/dev/null; then
    local running
    running=$(podman_c inspect --format '{{.State.Running}}' "$container" 2>/dev/null || printf false)
    [[ "$running" != true ]] || die "container is already running: $session"
  fi
  run_container "$session" "$detach" "$@"
}

cmd_logs() {
  local session=${1:?session name required}; shift
  load_meta "$session"
  podman_c container exists "$container" 2>/dev/null || die "container is absent: $session"
  podman_exec_c logs "$@" "$container"
}

cmd_shell() {
  local session=${1:?session name required}; shift
  load_meta "$session"
  podman_c container exists "$container" 2>/dev/null || die "container is not running: $session"
  if (( $# == 0 )); then
    podman_exec_c exec --interactive --tty "$container" /bin/bash
  else
    podman_exec_c exec --interactive --tty "$container" "$@"
  fi
}

cmd_stop() {
  load_meta "${1:?session name required}"
  if podman_c container exists "$container" 2>/dev/null; then
    podman_c stop --time 10 "$container"
  else
    log "container already absent: $container"
  fi
}

cmd_destroy() {
  local session=${1:?session name required}; shift
  local force=false delete_branch=false
  while (( $# )); do
    case "$1" in
      --force) force=true ;;
      --delete-branch) delete_branch=true ;;
      *) die "unknown destroy option: $1" ;;
    esac
    shift
  done
  load_meta "$session"

  if podman_c container exists "$container" 2>/dev/null; then
    podman_c rm --force --time 5 "$container"
  fi

  if [[ -d "$worktree" ]]; then
    if [[ "$force" = false && -n "$(git -C "$worktree" status --porcelain)" ]]; then
      die "worktree has uncommitted changes; commit them or use --force"
    fi
    if [[ "$force" = true ]]; then
      git --git-dir="$pool" worktree remove --force "$worktree"
    else
      git --git-dir="$pool" worktree remove "$worktree"
    fi
  fi

  if [[ "$delete_branch" = true ]]; then
    git --git-dir="$pool" branch -D "$branch"
  fi
  rm -rf -- "$META_DIR"
  log "destroyed session $session"
}

cmd_doctor() {
  need podman
  printf 'podman:          %s\n' "$(command -v podman)"
  printf 'runtime:         %s\n' "$PODMAN_RUNTIME"
  printf 'cgroup manager:  %s\n' "${CGROUP_MANAGER:-<podman default>}"
  printf 'runtime flags:   %s\n' \
    "${PODMAN_RUNTIME_FLAGS[*]+"${PODMAN_RUNTIME_FLAGS[*]}"}"
  if cgroups_ignored; then
    printf 'limits:          %s\n' "$(limits_note)"
    printf '                 unset AGENT_PODMAN_RUNTIME_FLAGS and delegate\n'
    printf '                 cgroup controllers to enforce them\n'
  else
    printf 'limits:          enforced via cgroups\n'
  fi
  printf 'image:           %s\n' "$DEFAULT_IMAGE"
  printf 'state:           %s\n' "$STATE_ROOT"
  printf 'model endpoint:  %s\n' "${AGENT_SANDBOX_MODEL_ENDPOINT:-<unset>}"
  check_runtime
  check_image "$DEFAULT_IMAGE"
  log "running a throwaway sandbox container"
  podman_c run --rm \
    --read-only \
    --read-only-tmpfs=true \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --userns=keep-id \
    "$DEFAULT_IMAGE" /bin/sh -c 'uname -srmo; id' ||
    die "$(
      printf 'sandbox startup failed; see the Podman/runsc error above.\n'
      printf 'Common causes:\n'
      printf '  - "systemd error: Access denied": the systemd cgroup manager\n'
      printf '    needs the system bus; set AGENT_PODMAN_CGROUP_MANAGER=cgroupfs\n'
      printf '  - "cannot set up cgroup for root": runsc cannot write the root\n'
      printf '    cgroup; set AGENT_PODMAN_RUNTIME_FLAGS=ignore-cgroups\n'
      printf '  - unprivileged user namespaces disabled, or missing\n'
      printf '    /etc/subuid and /etc/subgid ranges for this user'
    )"
  log "sandbox works"

  # Model access is the one thing a working sandbox still gets wrong silently:
  # the host LiteLLM proxy is loopback-only, and a sandbox's own loopback is
  # NOT the host's. Probe the endpoint from inside a throwaway sandbox, which
  # is the only place where the answer is meaningful.
  #
  # Any HTTP response counts as reachable (401/404 included) — this checks
  # connectivity, not the API contract, so no token is needed.
  if [[ -n "${AGENT_SANDBOX_MODEL_ENDPOINT-}" ]]; then
    log "checking model endpoint $AGENT_SANDBOX_MODEL_ENDPOINT from inside a sandbox"
    if podman_c run --rm \
      --read-only \
      --read-only-tmpfs=true \
      --cap-drop=ALL \
      --security-opt=no-new-privileges \
      --userns=keep-id \
      "$DEFAULT_IMAGE" \
      /bin/sh -c "curl -sS -o /dev/null --max-time 5 -w 'HTTP %{http_code}\n' \"\$0\"" \
      "$AGENT_SANDBOX_MODEL_ENDPOINT"; then
      log "model endpoint reachable from the sandbox"
    else
      log "$(
        printf 'warning: model endpoint %s is NOT reachable from a sandbox.\n' \
          "$AGENT_SANDBOX_MODEL_ENDPOINT"
        printf 'The endpoint must be a HOST address the sandbox can route to;\n'
        printf 'the host loopback is not one, and neither is the sandbox loopback:\n'
        printf '  - runsc runs its own network stack, so a pasta "-T" listener in\n'
        printf '    the container netns is invisible to the sandbox loopback;\n'
        printf '  - host.containers.internal maps to the host GLOBAL address\n'
        printf '    (pasta --map-guest-addr), not to the host loopback.\n'
        printf 'On NixOS check the bridge endpoint:\n'
        printf '  ip addr show agentsbr0\n'
        printf '  systemctl status gvisor-agent-sandbox-litellm-proxy.socket'
      )"
    fi
  fi
}

main() {
  local sub=${1:-}
  case "$sub" in
    start) shift; cmd_start "$@" ;;
    list) shift; cmd_list "$@" ;;
    status) shift; cmd_status "$@" ;;
    run) shift; cmd_run "$@" ;;
    logs) shift; cmd_logs "$@" ;;
    shell) shift; cmd_shell "$@" ;;
    stop) shift; cmd_stop "$@" ;;
    destroy) shift; cmd_destroy "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    -h|--help|help|'') usage ;;
    *) die "unknown subcommand: $sub" ;;
  esac
}

main "$@"
