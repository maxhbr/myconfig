#
# ser2net: serial-to-TCP forwarding on host thing.
#
# Upstream NixOS has no services.ser2net module, so this defines the
# systemd unit directly around the ser2net 4.x YAML config format
# (documented in ser2net.yaml(5) and gensio(5)).
#
# The TCP port is reachable from mysbx sandboxes:
#   - bubblewrap/nono/krun:  telnet 127.0.0.1 <port>
#   - microvm (qemu/CH):     telnet 10.0.2.2 <port>  (SLiRP/passt gateway)
# See modules/myconfig.ai.dev/mysbx/docs/design/serial-forward.md.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.myconfig.host.thing.ser2net;

  # gensio serialoptions format: <speed><parity><databits><stopbits>,
  # e.g. "115200N81" (see gensio(5), section Serialoptions).
  serialOptions = p: "${p.baud}${p.parity}${p.dataBits}${p.stopBits}";

  connection =
    p:
    let
      # RFC 2217 lets the remote side (re)negotiate baud/parity, so
      # prefer it for the telnet accepter; raw TCP is available too.
      accepter =
        if p.rfc2217 then
          "telnet(rfc2217),tcp,127.0.0.1,${toString p.port}"
        else
          "tcp,127.0.0.1,${toString p.port}";
    in
    ''
      connection: &con${toString p.port}
        accepter: ${accepter}
        connector: serialdev,${p.device},${serialOptions p}
        timeout: ${toString cfg.timeout}
        enable: on
    '';

  ser2netConf = (
    pkgs.writeText "ser2net-thing.yaml" (
      ''
        # Generated by hosts/host.thing/services.ser2net.nix — do not edit.
        %YAML 1.1
        ---
      ''
      + lib.concatMapStringsSep "\n" connection cfg.ports
    )
  );
in
{
  options.myconfig.host.thing.ser2net = with lib; {
    enable = mkEnableOption "ser2net serial-to-TCP forwarding";

    ports = mkOption {
      type = types.listOf (
        types.submodule {
          options = {
            port = mkOption {
              type = types.port;
              description = "TCP port to listen on (127.0.0.1 only).";
            };
            device = mkOption {
              type = types.str;
              description = "Host-side serial device path, e.g. /dev/ttyACM0.";
            };
            baud = mkOption {
              type = types.strMatching "[0-9]+";
              default = "115200";
              description = "Baud rate.";
            };
            dataBits = mkOption {
              type = types.enum [
                "5"
                "6"
                "7"
                "8"
              ];
              default = "8";
              description = "Data bits.";
            };
            parity = mkOption {
              type = types.enum [
                "N"
                "E"
                "O"
                "M"
                "S"
              ];
              default = "N";
              description = "Parity: none, even, odd, mark, space.";
            };
            stopBits = mkOption {
              type = types.enum [
                "1"
                "2"
              ];
              default = "1";
              description = "Stop bits.";
            };
            rfc2217 = mkOption {
              type = types.bool;
              default = true;
              description = "Advertise RFC 2217 telnet so clients can control serial parameters remotely.";
            };
          };
        }
      );
      default = [ ];
      description = "Serial-to-TCP forwarding entries, one per device.";
    };

    timeout = mkOption {
      type = types.ints.unsigned;
      default = 0;
      description = "Idle connection timeout in seconds; 0 disables it.";
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = cfg.ports != [ ];
        message = "myconfig.host.thing.ser2net.enable requires at least one entry in .ports";
      }
    ];

    systemd.services.ser2net = {
      description = "ser2net — serial-to-TCP forwarding";
      documentation = [
        "man:ser2net(8)"
        "man:ser2net.yaml(5)"
      ];
      # ser2net opens serial devices lazily on first TCP connection,
      # so no dev-*.device ordering is required here.
      wantedBy = [ "multi-user.target" ];

      serviceConfig = {
        Type = "simple";
        ExecStart = "${pkgs.ser2net}/bin/ser2net -c ${ser2netConf} -n -u";
        # ser2net re-reads the config on SIGHUP; the config file is
        # immutable in the store, so just restart on failure.
        Restart = "on-failure";
        RestartSec = "5s";
        # Serial device access needs root (or the dialout group) and
        # a real device tree — no sandboxing of /dev.
        User = "root";
        PrivateTmp = true;
        ProtectSystem = "strict";
        ProtectHome = true;
        PrivateDevices = false;
        DeviceAllow = [
          "char-ttyACM"
          "char-ttyUSB"
          "char-ttyS"
        ];
      };
    };

    # socat is the workhorse for testing and for bridging the TCP
    # stream onto a PTY inside a sandbox.
    environment.systemPackages = [ pkgs.socat ];
  };
}
